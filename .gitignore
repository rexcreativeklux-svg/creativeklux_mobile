# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ── Creative Klux ────────────────────────────────────────────────────────────
# Throwaway screenshots from layout tests.
shots/

# Secrets — never commit these. (android/.gitignore already covers
# key.properties / *.jks / *.keystore for Android release signing.)
.env
.env.*
*.p12
*.mobileprovision
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

# Scratch output from the data generators in tool/ (e.g. the Pexels fetch).
tool/**/out*.json
tool/**/*.tmp.mjs

# Claude Code's local per-user settings.
.claude/settings.local.json
